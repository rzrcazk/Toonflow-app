# =============================================
# Toonflow 环境变量配置模板
# =============================================

# ---------------------------------------------
# 数据库配置
# ---------------------------------------------
# 数据库类型：sqlite 或 pg
# - sqlite: 使用本地 SQLite 文件（默认，无需额外配置）
# - pg: 使用 PostgreSQL 数据库（需要安装 PostgreSQL）
DB_TYPE=sqlite

# PostgreSQL 配置（仅当 DB_TYPE=pg 时需要）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=toonflow
PG_USER=postgres
PG_PASSWORD=postgres

# ---------------------------------------------
# 服务配置
# ---------------------------------------------
# 运行环境：dev | prod
NODE_ENV=dev

# 服务端口（默认 10588）
PORT=10588

# ---------------------------------------------
# 对象存储配置（可选）
# ---------------------------------------------
# OSSURL=http://localhost:9000

# ---------------------------------------------
# AI 模型配置（可选）
# ---------------------------------------------
# OPENAI_API_KEY=your-api-key
# ANTHROPIC_API_KEY=your-api-key
# GOOGLE_API_KEY=your-api-key
# DEEPSEEK_API_KEY=your-api-key
# ZHIPU_API_KEY=your-api-key
# MINIMAX_API_KEY=your-api-key
# QWEN_API_KEY=your-api-key
# XAI_API_KEY=your-api-key

# ---------------------------------------------
# 调试配置（可选）
# ---------------------------------------------
# AI_DEBUG=1      # 启用 AI 调用详细日志（打印请求参数和响应）
# SQL_DEBUG=1     # 启用 SQL 语句详细日志（打印所有 SQL 查询）
