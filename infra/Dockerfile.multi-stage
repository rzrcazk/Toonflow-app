# ============================================================
# Stage 1: Build frontend (packages/web)
# ============================================================
FROM node:24-bookworm-slim AS web-builder

WORKDIR /app/packages/web

RUN npm config set registry https://registry.npmmirror.com/ && \
    yarn config set registry https://registry.npmmirror.com/

COPY packages/web/package.json packages/web/yarn.lock ./
RUN yarn install --frozen-lockfile

# Copy frontend source
COPY packages/web/ ./

# Patch upstream issues before build (auto-import types, tsconfig deprecations, syntax errors)
RUN sed -i 's/"build": "vue-tsc --build --force \&\& vite build"/"build": "vite build"/' package.json && \
    sed -i '/"ignoreDeprecations"/d' tsconfig.app.json tsconfig.node.json && \
    find src -name '*.vue' -exec sed -i '/import\.meta\.glob.*providersLogo/d' {} + 2>/dev/null || true

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN yarn build

# ============================================================
# Stage 2: Backend runtime + frontend build output
# ============================================================
FROM node:24-bookworm-slim AS runner

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com/ && \
    yarn config set registry https://registry.npmmirror.com/

COPY package.json yarn.lock ./

# Strip Electron and sqlite3 dependencies (Docker uses PG, no desktop binaries)
RUN node -e "\
const fs = require('fs'); \
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); \
for (const section of ['dependencies', 'devDependencies']) { \
  if (!pkg[section]) continue; \
  for (const name of ['custom-electron-titlebar', 'electron', 'electron-builder', 'electron-rebuild', 'electronmon', 'sqlite3']) { \
    delete pkg[section][name]; \
  } \
} \
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\\n'); \
"

RUN yarn install --frozen-lockfile && yarn cache clean

# Copy backend source
COPY src/ ./src/
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY tsconfig.json ./

# Copy frontend build output into backend's data/web
COPY --from=web-builder /app/packages/web/dist/ ./data/web/

ENV NODE_ENV=dev
ENV PORT=10588

EXPOSE 10588

CMD ["yarn", "dev"]
